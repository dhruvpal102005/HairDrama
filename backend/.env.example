# Flask Configuration
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# Supabase Database
# Get these from: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# Clerk Authentication
# Get from: https://dashboard.clerk.com -> API Keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Resend Email Service (Optional - for email notifications)
# Get from: https://resend.com -> API Keys
RESEND_API_KEY=re_your_resend_api_key

# Replicate AI (Optional - for AI image generation)
# Get from: https://replicate.com -> Account -> API Tokens
REPLICATE_API_TOKEN=r8_your_replicate_token

# Redis (for background jobs)
REDIS_URL=redis://localhost:6379

# Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
